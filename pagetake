#!/usr/bin/env node
import { spawn } from "node:child_process";
import { once } from "node:events";
import { cp, mkdir, readdir, readFile, rename, rm } from "node:fs/promises";
import { dirname, join, resolve } from "node:path";
import { createInterface } from "node:readline";
import { setTimeout as delay } from "node:timers/promises";
import { fileURLToPath } from "node:url";

const tool = dirname(fileURLToPath(import.meta.url));
const root = resolve(process.env.PAGETAKE_DIR ?? process.env.WEB_REPLAY_DIR ?? join(tool, "recordings"));

const usage = `Usage
  ./pagetake --version                  Print the version
  ./pagetake clone <URL> <project>       Create or refresh a recorded project
  ./pagetake open <project> [version]    Start the preview (default: source)
  ./pagetake score <project> [version]   Capture and score a preview (default: source)
  ./pagetake baseline <plan> <new-dir>  Save a verification reference
  ./pagetake verify <plan> <new-dir>    Compare states [--baseline <dir>]
  ./pagetake repair <verify.json>       Regenerate the repair checklist
  ./pagetake ai <project> [version]      Generate a draft with the model from .env
  ./pagetake fill-media <project>        Complete recorded audio and video ranges
  ./pagetake export <project> [version] [--no-recover-images]
                                        Export an existing recording
  ./pagetake guide <project> [version]   Generate guides for an existing export
Projects live in recordings/. Clone scrolls the full page by default.
Use --scroll manual, --scroll 800:2400, or --scroll "#section" to change it.
Use --actions <file> for interaction frames and named checkpoints.`;

function validName(name) {
  if (!/^[a-z0-9][a-z0-9_-]{0,63}$/i.test(name ?? "")) {
    throw new Error("Project and version names may contain letters, numbers, hyphens, and underscores");
  }
  return name;
}

function cli(...args) {
  return run([join(tool, "pagetake.mjs"), ...args]);
}

async function run(args) {
  const child = spawn(process.execPath, args, { stdio: "inherit", cwd: tool });
  const [code, signal] = await once(child, "exit");
  if (code !== 0) throw new Error(`Command exited (${signal ?? code})`);
}

async function cloneProject(url, name, args) {
  const project = join(root, name);
  await mkdir(project, { recursive: true });
  const work = join(project, ".pagetake-clone");
  try {
    await mkdir(work);
  } catch (error) {
    if (error.code !== "EEXIST") throw error;
    throw new Error(`Clone workspace already exists: ${work}. Another clone may be running or need recovery.`, { cause: error });
  }
  const previous = [], installed = [];
  let keepWorkspace = false;
  try {
    const reference = join(work, "reference");
    const source = join(work, "source");
    await cli("record", url, reference, "--seconds", "60", "--samples", "6", "--scroll", "full", ...args);
    await cli("export", reference, source, ...args.filter((arg) => arg === "--no-recover-images"));

    // Carry user-added files (such as a React reconstruction) into the new default export.
    const oldSource = join(project, "source");
    const generated = new Set([...await readdir(source), "scenes"]);
    const oldFiles = await readdir(oldSource).catch((error) => {
      if (error.code !== "ENOENT" && error.code !== "ENOTDIR") throw error;
      return [];
    });
    for (const file of oldFiles) {
      if (!generated.has(file)) await cp(join(oldSource, file), join(source, file), { recursive: true, verbatimSymlinks: true });
    }

    for (const directory of ["reference", "source"]) {
      try {
        await rename(join(project, directory), join(work, directory + "-previous"));
        previous.push(directory);
      } catch (error) {
        if (error.code !== "ENOENT") throw error;
      }
    }
    for (const directory of ["reference", "source"]) {
      await rename(join(work, directory), join(project, directory));
      installed.push(directory);
    }
  } catch (error) {
    try {
      for (const directory of installed) await rename(join(project, directory), join(work, directory));
      for (const directory of previous) await rename(join(work, directory + "-previous"), join(project, directory));
    } catch (rollbackError) {
      keepWorkspace = true;
      throw new Error(`Clone could not restore the previous files. Recovery files are in ${work}.`,
        { cause: new AggregateError([error, rollbackError]) });
    }
    throw error;
  } finally {
    if (!keepWorkspace) await rm(work, { recursive: true, force: true });
  }
  console.log(`Preview: ./pagetake open ${name}\nScore: ./pagetake score ${name}`);
}

async function startServer(project) {
  const child = spawn(process.execPath, [join(tool, "serve.mjs"), project, "0"], {
    stdio: ["ignore", "pipe", "inherit"],
  });
  const lines = createInterface({ input: child.stdout });
  try {
    const url = await Promise.race([
      once(lines, "line").then(([line]) => line),
      once(child, "exit").then(() => { throw new Error("Preview server failed to start"); }),
      delay(5000, undefined, { ref: false }).then(() => { throw new Error("Preview server startup timed out"); }),
    ]);
    if (!/^http:\/\/127\.0\.0\.1:\d+\/$/.test(url)) throw new Error("Preview server did not return a loopback URL");
    return { url, close: () => child.kill() };
  } catch (error) {
    child.kill();
    throw error;
  } finally {
    lines.close();
  }
}

async function score(project, reference, version, args) {
  if (args.some((arg) => arg !== "--headless")) throw new Error("score accepts only --headless");
  const manifest = JSON.parse(await readFile(join(reference, "manifest.json"), "utf8"));
  const { width, height } = manifest.viewport;
  const seconds = manifest.durationSeconds ?? Math.max(2, Math.round(manifest.samples.at(-1).elapsedMs / 1000));
  const positions = manifest.scroll && manifest.scroll !== "manual" ? ["--match", join(reference, "manifest.json")] : [];
  const actionOptions = manifest.actions?.length ? ["--actions", join(reference, "actions.json")] : [];
  const reducedMotion = manifest.motion?.reducedMotion;
  const motionOptions = typeof reducedMotion === "boolean"
    ? [reducedMotion ? "--reduced-motion" : "--no-reduced-motion"] : [];
  if (manifest.motion?.watchSelector) motionOptions.push("--watch", manifest.motion.watchSelector);
  const preview = await startServer(join(project, version));
  try {
    const reports = join(project, "reports");
    await mkdir(reports, { recursive: true });
    const folder = join(reports, `${version}-${Date.now()}`);
    await cli("inspect", preview.url, folder,
      "--width", String(width), "--height", String(height),
      "--seconds", String(seconds), "--samples", String(manifest.samples.length), ...positions, ...actionOptions, ...motionOptions, ...args);
    await cli("compare", reference, folder);
    const result = JSON.parse(await readFile(join(folder, "compare.html.json"), "utf8"));
    console.log(`Visual ${result.visual ?? "unscored"} / 100 · Motion ${result.motion ?? "unscored"} / 100 · comparable ${result.comparable} / ${result.total} frames`);
    console.log(`Report: ${join(folder, "compare.html")}`);
  } finally {
    preview.close();
  }
}

async function main() {
  const [command, first, second, ...args] = process.argv.slice(2);
  if (command === "--version") {
    const { version } = JSON.parse(await readFile(join(tool, "package.json"), "utf8"));
    console.log(version);
    return;
  }
  if (!command || ["help", "--help", "-h"].includes(command)) {
    console.log(usage);
    return;
  }
  if (command === "repair" && first && !second) return cli("repair", resolve(first));
  if (["baseline", "verify"].includes(command) && first && second) {
    const flags = args.map((arg, index) => args[index - 1] === "--baseline" && !arg.startsWith("--") ? resolve(arg)
      : arg.startsWith("--baseline=") && arg.length > "--baseline=".length ? "--baseline=" + resolve(arg.slice("--baseline=".length))
      : arg);
    return cli(command, resolve(first), resolve(second), ...flags);
  }
  if (command === "clone") {
    if (!first || !second) throw new Error("Usage: ./pagetake clone <URL> <project>");
    return cloneProject(first, validName(second), args);
  }
  if (!["fill-media", "export", "guide", "open", "score", "ai"].includes(command)) throw new Error(usage);
  const project = join(root, validName(first));
  const reference = join(project, "reference");
  if (command === "fill-media") return cli("fill-media", reference, ...[second, ...args].filter((value) => value !== undefined));
  const versionIsOption = second?.startsWith("--");
  const version = validName((versionIsOption ? undefined : second) ?? (command === "ai" ? "draft" : "source"));
  const flags = versionIsOption ? [second, ...args] : args;
  if (command === "export") return cli("export", reference, join(project, version), ...flags);
  if (command === "guide") return cli("guide", reference, join(project, version));
  if (command === "open") return run([join(tool, "serve.mjs"), join(project, version)]);
  if (command === "score") return score(project, reference, version, flags);
  if (command === "ai") {
    const env = join(tool, ".env");
    return run([`--env-file-if-exists=${env}`, join(tool, "pagetake.mjs"),
      "generate", reference, join(project, version), ...flags]);
  }
}

try {
  await main();
} catch (error) {
  console.error(error.message);
  process.exitCode = 1;
}
